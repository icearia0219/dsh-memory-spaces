{
  "name": "dsh-memory-spaces",
  "version": "0.1.0",
  "packageManager": "pnpm@11.22.0",
  "description": "Explicitly governed shared memory spaces for DeepSeek Harness sessions",
  "author": "付雨嫣",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client.d.cts",
      "default": "./lib/client.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "LICENSE",
    "AGENTS.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "screenshots.json",
    "assets",
    "README.md",
    "README.zh.md",
    "docs"
  ],
  "scripts": {
    "clean": "node ./scripts/clean-build.mjs",
    "build": "pnpm run clean && pnpm run typecheck && tsdown && node ./scripts/finalize-build.mjs",
    "lint": "oxlint --deny-warnings src test scripts tsdown.config.ts",
    "typecheck": "tsc --project tsconfig.json --pretty false && tsc --project tsconfig.client.json --pretty false",
    "test": "pnpm run build && node --import tsx/esm --test test/*.test.mjs",
    "test:coverage": "pnpm run build && c8 --all --include=lib/index.js --check-coverage --lines 95 --branches 80 --functions 95 --statements 95 --reporter=text --reporter=json-summary node --import tsx/esm --test test/*.test.mjs",
    "test:migration": "pnpm run build && node --import tsx/esm --test --test-name-pattern=\"schema|migration|database restart\" test/database.test.mjs",
    "test:security": "pnpm run build && node --import tsx/esm --test --test-name-pattern=\"human|snapshot|sensitive|unknown schemas|boundary validation|token|provenance\" test/*.test.mjs",
    "doctor:fts": "pnpm run build && node ./scripts/check-fts.mjs",
    "benchmark": "pnpm run build && node ./scripts/benchmark.mjs",
    "verify:mount-page": "node ./scripts/verify-mounted-web.mjs",
    "package:check": "pnpm run build && publint --strict && attw --pack . --profile esm-only",
    "prepare": "pnpm run build",
    "prepack": "pnpm run build"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": ">=0.1.0-rc.6 <0.2.0",
    "@deepseek-ai/dsh-api-remotes": ">=0.1.0-rc.6 <0.2.0",
    "@deepseek-ai/dsh-client-locale": ">=0.1.0-rc.6 <0.2.0",
    "@deepseek-ai/dsh-client-runtime": ">=0.1.0-rc.6 <0.2.0",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.1.0-rc.6 <0.2.0",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.1.0-rc.6 <0.2.0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.0-rc.6 <0.2.0",
    "@deepseek-ai/dsh-client-ui-workspace": ">=0.1.0-rc.6 <0.2.0",
    "@deepseek-ai/dsh-commands": ">=0.1.0-rc.6 <0.2.0",
    "@deepseek-ai/dsh-llm": ">=0.1.0-rc.6 <0.2.0",
    "@deepseek-ai/dsh-session": ">=0.1.0-rc.6 <0.2.0",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.0-rc.7",
    "@deepseek-ai/dsh-api-remotes": "0.1.0-rc.7",
    "@deepseek-ai/dsh-client-locale": "0.1.0-rc.7",
    "@deepseek-ai/dsh-client-runtime": "0.1.0-rc.7",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.0-rc.7",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.0-rc.7",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.0-rc.7",
    "@deepseek-ai/dsh-client-ui-workspace": "0.1.0-rc.7",
    "@deepseek-ai/dsh-commands": "0.1.0-rc.7",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.7",
    "@deepseek-ai/dsh-session": "0.1.0-rc.7",
    "@types/node": "^22.19.0",
    "@types/react": "~18.3.1",
    "c8": "^12.0.0",
    "lightningcss": "^1.32.0",
    "oxlint": "^1.79.0",
    "playwright": "1.62.1",
    "publint": "^0.3.24",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsdown": "^0.22.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/icearia0219/dsh-memory-spaces.git"
  },
  "homepage": "https://github.com/icearia0219/dsh-memory-spaces#readme",
  "bugs": {
    "url": "https://github.com/icearia0219/dsh-memory-spaces/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "agent-memory",
    "session-memory",
    "shared-memory"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-api-remotes"
      ],
      "platform": "web"
    }
  },
  "license": "MIT"
}
